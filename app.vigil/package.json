    "@intlify/unplugin-vue-i18n": "^11.0.1",
    "@primeuix/themes": "^2.0.2",
    "@primevue/forms": "^4.5.4",
    "@sentry/vue": "^10.29.0",
    "@tailwindcss/vite": "^4.1.17",
    "@vueuse/core": "^14.2.1",
    "axios": "^1.13.2",
    "chart.js": "^4.5.1",
