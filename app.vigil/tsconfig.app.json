{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "components.d.ts", "src/**/*", "src/**/*.vue"],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    "paths": {
      "@/*": ["./src/*"],
      "@Composables": ["./src/composables"],
      "@Composables/*": ["./src/composables/*"],
      "@Assets": ["./src/assets"],
      "@Assets/*": ["./src/assets/*"],
      "@Constants": ["./src/constants"],
      "@Constants/*": ["./src/constants/*"],
      "@Enums": ["./src/enums"],
      "@Enums/*": ["./src/enums/*"],
      "@Helpers": ["./src/helpers"],
      "@Helpers/*": ["./src/helpers/*"],
      "@Interfaces": ["./src/interfaces"],
      "@Interfaces/*": ["./src/interfaces/*"],
      "@Libraries": ["./src/libraries"],
      "@Libraries/*": ["./src/libraries/*"],
      "@Plugins": ["./src/plugins"],
      "@Plugins/*": ["./src/plugins/*"],
      "@Providers": ["./src/providers"],
      "@Providers/*": ["./src/providers/*"],
      "@Stores": ["./src/stores"],
      "@Stores/*": ["./src/stores/*"],
      "@Styles": ["./src/styles"],
      "@Styles/*": ["./src/styles/*"],
      "@Types": ["./src/types"],
      "@Types/*": ["./src/types/*"],

      "@AuthModule": ["./src/modules/Auth"],
      "@AuthModule/*": ["./src/modules/Auth/*"],
      "@HomeModule": ["./src/modules/Home"],
      "@HomeModule/*": ["./src/modules/Home/*"],
      "@ShowcaseModule": ["./src/modules/Showcase"],
      "@ShowcaseModule/*": ["./src/modules/Showcase/*"],
      "@UserModule": ["./src/modules/User"],
      "@UserModule/*": ["./src/modules/User/*"],
      "@ProjectModule": ["./src/modules/Project"],
      "@ProjectModule/*": ["./src/modules/Project/*"],
      "@MonitorModule": ["./src/modules/Monitor"],
      "@MonitorModule/*": ["./src/modules/Monitor/*"]
    }
  }
}
