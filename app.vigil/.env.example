# URLs
VITE_API_URL=
VITE_APP_URL=

# Sentry
VITE_SENTRY=
VITE_SENTRY_PROPAGATION_TARGETS="['localhost', 'https://myappwithport.test:5173', 'https://myappwithoutport.test']"
VITE_SENTRY_AUTH_TOKEN=
SENTRY_AUTH_TOKEN=
VITE_SENTRY_PROJECT_NAME=project_name_that_will_be_on_sentry

# SSL
VITE_LOCAL_SSL_KEY=".config/valet/Certificates/siteName.test.key"
VITE_LOCAL_SSL_CERT=".config/valet/Certificates/siteName.test.crt"

# Theme: active brand theme — must match a file in src/styles/theme/themes/<name>.css
VITE_ACTIVE_THEME=battoni-dev

# Language
VITE_DEFAULT_LANGUAGE=en

# Auth: default login entry — `phone` (WhatsApp), `password` (phone/email + password), or `username` (email-first OTP).
VITE_LOGIN_FLOW=password

# Auth: phone mock is fixed in code (only 99999999999 → existing user) until backend exists.
